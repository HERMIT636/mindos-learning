  "tasks": [
    {
      "id": "explain-return",
      "task_type": "short_answer",
      "purpose": "practice",
      "prompt": "在函数中，return 和 print 的主要作用有什么不同？",
      "concept_ids": [
        "return-value"
      ],
      "dimension_ids": [
        "understanding"
      ],
      "rubric": [
        {
          "dimension_id": "understanding",
          "criterion": "2 分：明确说明 return 将值交回调用者且结束本次函数执行；只说出其中一项得 1 分；均未说出得 0 分",
          "max_score": 2
        },
        {
          "dimension_id": "understanding",
          "criterion": "2 分：说明 print 用于显示且显示内容不会自动成为所在函数的返回值；只说出其中一项得 1 分；均未说出得 0 分",
          "max_score": 2
        }
      ],
      "reference_answer": "return 将值交给调用者并结束本次函数执行；print 用于显示内容。函数执行到末尾而没有执行 return 时，调用结果是 None。"
    },
    {
      "id": "implement-add",
      "task_type": "code",
      "purpose": "practice",
      "prompt": "实现 add(a, b)，要求返回两个输入数的和，不需要打印。",
      "concept_ids": [
        "functions",
        "return-value"
      ],
      "dimension_ids": [
        "implementation"
      ],
      "rubric": [
        {
          "dimension_id": "implementation",
          "criterion": "1 分：定义名为 add、接受 a 和 b 两个参数的函数；否则 0 分",
          "max_score": 1
        },
        {
          "dimension_id": "implementation",
          "criterion": "2 分：对数值输入返回 a + b 且调用者可取得结果；仅正确计算但未返回得 1 分；否则 0 分",
          "max_score": 2
        },
        {
          "dimension_id": "implementation",
          "criterion": "1 分：函数内不使用 print 代替返回；否则 0 分",
          "max_score": 1
        }
      ],
      "reference_answer": "def add(a, b):\n    return a + b"
    },
    {
      "id": "identify-call",
      "task_type": "single_choice",
      "purpose": "practice",
      "prompt": "已定义函数 greet。下列哪一项会调用它？",
      "concept_ids": [
        "functions"
      ],
      "dimension_ids": [
        "understanding"
      ],
      "choices": [
        {
          "id": "a",
          "text": "def greet():"
        },
        {
          "id": "b",
          "text": "greet()"
        },
        {
          "id": "c",
          "text": "return greet"
        }
      ],
      "rubric": [
        {
          "dimension_id": "understanding",
          "criterion": "1 分：识别 greet() 是调用，区别于 def 定义或 return 引用；否则 0 分",
          "max_score": 1
        }
      ],
      "reference_answer": "b"
    },
    {
      "id": "identify-call-with-argument",
      "task_type": "single_choice",
      "purpose": "practice",
      "prompt": "已定义函数 double(x)。下列哪一项会调用它，并把 3 传给 x？",
      "concept_ids": [
        "functions"
      ],
      "dimension_ids": [
        "understanding"
      ],
      "choices": [
        {
          "id": "a",
          "text": "double"
        },
        {
          "id": "b",
          "text": "double(3)"
        },
        {
          "id": "c",
          "text": "def double(3):"
        }
      ],
      "rubric": [
        {
          "dimension_id": "understanding",
          "criterion": "1 分：识别 double(3) 为带实参的函数调用，区别于函数引用和定义；否则 0 分",
          "max_score": 1
        }
      ],
      "reference_answer": "b"
    },
    {
      "id": "return-vs-print",
      "task_type": "single_choice",
      "purpose": "practice",
      "prompt": "哪句话准确描述 return 与 print 的区别？",
      "concept_ids": [
        "return-value"
      ],
      "dimension_ids": [
        "understanding"
      ],
      "choices": [
        {
          "id": "a",
          "text": "print 会把显示的值自动返回给调用者"
        },
        {
          "id": "b",
          "text": "return 只负责把内容显示在屏幕上"
        },
        {
          "id": "c",
          "text": "return 将值交回调用者；print 主要显示内容"
        }
      ],
      "rubric": [
        {
          "dimension_id": "understanding",
          "criterion": "1 分：区分 return 交回调用者与 print 显示内容；否则 0 分",
          "max_score": 1
        }
      ],
      "reference_answer": "c"
    },
    {
      "id": "read-return-value",
      "task_type": "single_choice",
      "purpose": "practice",
      "prompt": "函数 show_then_add(x) 先执行 print(x)，再执行 return x + 2。调用 result = show_then_add(4) 后，屏幕显示什么，result 是什么？",
      "concept_ids": [
        "return-value"
      ],
      "dimension_ids": [
        "understanding"
      ],
      "choices": [
        {
          "id": "a",
          "text": "显示 4，result 为 6"
        },
        {
          "id": "b",
          "text": "显示 6，result 为 4"
        },
        {
          "id": "c",
          "text": "显示 4，result 为 None"
        }
      ],
      "rubric": [
        {
          "dimension_id": "understanding",
          "criterion": "1 分：同时正确判断 print 的显示内容和 return 的调用结果；否则 0 分",
          "max_score": 1
        }
      ],
      "reference_answer": "a"
    }
  ]
}
