  "tasks": [
    {
      "id": "calculate-dot-product",
      "task_type": "numeric",
      "purpose": "practice",
      "prompt": "计算二维实向量 (1, 2) 与 (3, 4) 的标准点积。",
      "concept_ids": [
        "dot-product"
      ],
      "dimension_ids": [
        "calculation"
      ],
      "rubric": [
        {
          "dimension_id": "calculation",
          "criterion": "按对应分量乘积求和，得到 11",
          "max_score": 2
        }
      ],
      "reference_answer": 11
    },
    {
      "id": "explain-zero-dot-product",
      "task_type": "short_answer",
      "purpose": "practice",
      "prompt": "向量 (1, 0) 与 (0, 1) 的点积为 0。它们是否都是零向量？说明原因。",
      "concept_ids": [
        "vectors",
        "dot-product"
      ],
      "dimension_ids": [
        "understanding"
      ],
      "rubric": [
        {
          "dimension_id": "understanding",
          "criterion": "指出两个向量都含非零分量，因此都不是零向量",
          "max_score": 2
        },
        {
          "dimension_id": "understanding",
          "criterion": "说明非零向量也可能点积为 0，在标准欧氏几何中这两个向量相互垂直",
          "max_score": 2
        }
      ],
      "reference_answer": "都不是零向量，因为它们各有一个分量是 1；点积为 1×0 + 0×1 = 0。在标准欧氏几何中，这两个非零向量相互垂直。"
    },
    {
      "id": "vector-component",
      "task_type": "single_choice",
      "purpose": "practice",
      "prompt": "二维向量 (2, -3) 的第二个分量是多少？",
      "concept_ids": [
        "vectors"
      ],
      "dimension_ids": [
        "understanding"
      ],
      "choices": [
        {
          "id": "a",
          "text": "2"
        },
        {
          "id": "b",
          "text": "-3"
        },
        {
          "id": "c",
          "text": "3"
        }
      ],
      "rubric": [
        {
          "dimension_id": "understanding",
          "criterion": "选出唯一正确答案",
          "max_score": 1
        }
      ],
      "reference_answer": "b"
    },
    {
      "id": "zero-vector",
      "task_type": "single_choice",
      "purpose": "practice",
      "prompt": "以下哪一个是二维零向量？",
      "concept_ids": [
        "vectors"
      ],
      "dimension_ids": [
        "understanding"
      ],
      "choices": [
        {
          "id": "a",
          "text": "(0, 1)"
        },
        {
          "id": "b",
          "text": "(1, 0)"
        },
        {
          "id": "c",
          "text": "(0, 0)"
        }
      ],
      "rubric": [
        {
          "dimension_id": "understanding",
          "criterion": "选出唯一正确答案",
          "max_score": 1
        }
      ],
      "reference_answer": "c"
    },
    {
      "id": "calculate-dot-product-variant",
      "task_type": "numeric",
      "purpose": "practice",
