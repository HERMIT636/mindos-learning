    },
    {
      "id": "diagnose-scaling-laws",
      "prompt": "并行加速比如何定义？",
      "choices": [
        {
          "id": "a",
          "text": "串行耗时除以并行耗时"
        },
        {
          "id": "b",
          "text": "并行耗时除以串行耗时"
        },
        {
          "id": "c",
          "text": "核心数除以输入数"
        }
      ],
      "concept_id": "scaling-laws",
      "dimension_id": "understanding",
      "answer": "a"
    },
    {
      "id": "diagnose-benchmark-profiling",
      "prompt": "比较两版性能前，首先应固定什么？",
      "choices": [
        {
          "id": "a",
          "text": "输入与测量条件"
        },
        {
          "id": "b",
          "text": "只保留最快成绩"
        },
        {
          "id": "c",
          "text": "关闭正确性检查"
        }
      ],
      "concept_id": "benchmark-profiling",
      "dimension_id": "understanding",
      "answer": "a"
    },
    {
      "id": "diagnose-openmp-parallel",
      "prompt": "并行求和通常应使用哪种机制？",
      "choices": [
        {
          "id": "a",
          "text": "reduction 归约"
        },
        {
          "id": "b",
          "text": "所有线程无保护写同一变量"
        },
        {
          "id": "c",
          "text": "只增加线程数"
        }
      ],
      "concept_id": "openmp-parallel",
      "dimension_id": "understanding",
      "answer": "a"
    },
    {
      "id": "diagnose-races-synchronization",
      "prompt": "多线程无同步更新同一计数器可能发生什么？",
      "choices": [
        {
          "id": "a",
          "text": "丢失更新"
        },
        {
          "id": "b",
          "text": "自动原子化"
        },
        {
          "id": "c",
          "text": "只影响编译速度"
        }
      ],
      "concept_id": "races-synchronization",
      "dimension_id": "understanding",
      "answer": "a"
    },
    {
      "id": "diagnose-mpi-distributed",
      "prompt": "MPI 各进程默认共享同一地址空间吗？",
      "choices": [
        {
          "id": "a",
          "text": "不共享"
        },
        {
          "id": "b",
          "text": "完全共享"
        },
        {
          "id": "c",
          "text": "只共享栈"
        }
      ],
      "concept_id": "mpi-distributed",
      "dimension_id": "understanding",
      "answer": "a"
    },
    {
      "id": "diagnose-gpu-model",
      "prompt": "很小的 GPU 任务可能不划算，主要因为什么？",
      "choices": [
        {
          "id": "a",
          "text": "启动和数据搬运开销"
        },
        {
          "id": "b",
          "text": "GPU 无法做加法"
        },
        {
          "id": "c",
          "text": "CPU 不需要内存"
        }
      ],
      "concept_id": "gpu-model",
      "dimension_id": "understanding",
      "answer": "a"
    },
    {
      "id": "diagnose-memory-optimization",
      "prompt": "算术强度通常是什么之比？",
      "choices": [
        {
          "id": "a",
          "text": "运算量除以数据搬运量"
        },
        {
          "id": "b",
          "text": "核心数除以线程数"
        },
        {
          "id": "c",
          "text": "内存大小除以时钟频率"
        }
      ],
      "concept_id": "memory-optimization",
      "dimension_id": "understanding",
      "answer": "a"
    }
